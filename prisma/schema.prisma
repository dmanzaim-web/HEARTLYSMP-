model BotLog {
  id        String      @id @default(cuid())
  serverId  String
  runtimeId String?
  level     String
  event     String
  message   String
  meta      String?
  createdAt DateTime    @default(now())

  server  Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  runtime BotRuntime? @relation(fields: [runtimeId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt])
  @@index([serverId, level, createdAt])
}